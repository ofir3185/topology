<external:ViewItemWpfUserControl
    x:Class="NetworkTopology.Client.NetworkTopologyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:external="clr-namespace:VideoOS.Platform.Client;assembly=VideoOS.Platform"
    Background="#FF101318">

    <external:ViewItemWpfUserControl.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#FF2A303A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF48515F"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DarkToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#FF2A303A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF48515F"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FF20252D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF3B4450"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style x:Key="LibraryList" TargetType="ListBox">
            <Setter Property="Background" Value="#FF12161B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF303640"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>
    </external:ViewItemWpfUserControl.Resources>

    <Grid Background="#FF101318">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF191D24" BorderBrush="#FF303640" BorderThickness="0,0,0,1" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Network Topology" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SummaryText" Text="Loading camera index..." Foreground="#FF9AA4B2" FontSize="12" Margin="18,4,0,0"/>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="ModeText" Text="Interactive boards" Foreground="#FF6FB6FF" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="RefreshCamerasButton" Content="Refresh cameras" Click="RefreshCamerasButton_Click" Style="{StaticResource DarkButton}"/>
                    <Button x:Name="ProbeButton" Content="Probe active board" Click="ProbeButton_Click" Style="{StaticResource DarkButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FF171B21" BorderBrush="#FF303640" BorderThickness="0,0,1,0" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="125"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Boards" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="NewBoardButton" Content="+" Click="NewBoardButton_Click" Style="{StaticResource DarkButton}" Padding="9,3"/>
                            <Button x:Name="DeleteBoardButton" Content="−" Click="DeleteBoardButton_Click" Style="{StaticResource DarkButton}" Padding="9,3"/>
                        </StackPanel>
                    </Grid>

                    <ListBox Grid.Row="1" x:Name="BoardList" SelectionChanged="BoardList_SelectionChanged" Style="{StaticResource LibraryList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Padding="7,5" Foreground="White" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2" Margin="0,7,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BoardNameBox" Style="{StaticResource DarkTextBox}" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Save name" Click="SaveBoardNameButton_Click" Style="{StaticResource DarkButton}"/>
                    </Grid>

                    <TabControl Grid.Row="3" Background="#FF171B21" Foreground="White" BorderBrush="#FF303640">
                        <TabItem Header="Cameras">
                            <Grid Background="#FF171B21" Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="CameraSearchBox" Grid.Row="0" Style="{StaticResource DarkTextBox}"
                                         TextChanged="CameraSearchBox_TextChanged" ToolTip="Search by camera name, IP, model or recording server"/>
                                <TextBlock x:Name="CameraCountText" Grid.Row="1" Text="Loading..." Foreground="#FF8E98A6" FontSize="10" Margin="2,5,0,5"/>
                                <ListBox x:Name="CameraList" Grid.Row="2" Style="{StaticResource LibraryList}"
                                         PreviewMouseLeftButtonDown="CameraList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="CameraList_PreviewMouseMove"
                                         MouseDoubleClick="CameraList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="5,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding CameraName}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Row="1" Foreground="#FF8E98A6" FontSize="9" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding IpAddress}"/><Run Text="   "/><Run Text="{Binding RecordingServerName}"/>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button Grid.Row="3" Content="Add selected to board" Click="AddSelectedCameraButton_Click" Style="{StaticResource DarkButton}" Margin="0,7,0,0"/>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Switches">
                            <Grid Background="#FF171B21" Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBox x:Name="SwitchSearchBox" Grid.Row="0" Style="{StaticResource DarkTextBox}" TextChanged="SwitchSearchBox_TextChanged"
                                         ToolTip="Search switches by name or IP"/>
                                <ListBox x:Name="SwitchList" Grid.Row="1" Margin="0,6,0,7" Style="{StaticResource LibraryList}"
                                         PreviewMouseLeftButtonDown="SwitchList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="SwitchList_PreviewMouseMove"
                                         MouseDoubleClick="SwitchList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="5,4">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding IpAddress}" Foreground="#FF8E98A6" FontSize="9"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="2" Text="Add switch" Foreground="White" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,5"/>
                                <TextBox x:Name="NewSwitchNameBox" Grid.Row="3" Style="{StaticResource DarkTextBox}" Margin="0,0,0,5" ToolTip="Switch name"/>
                                <TextBox x:Name="NewSwitchIpBox" Grid.Row="4" Style="{StaticResource DarkTextBox}" Margin="0,0,0,5" ToolTip="Management IP (optional)"/>
                                <StackPanel Grid.Row="5">
                                    <Button Content="Add to switch library" Click="AddSwitchButton_Click" Style="{StaticResource DarkButton}" Margin="0,0,0,6"/>
                                    <Button Content="Add selected to board" Click="AddSelectedSwitchButton_Click" Style="{StaticResource DarkButton}" Margin="0,0,0,6"/>
                                    <CheckBox x:Name="AutoLldpCheckBox" IsChecked="True" Foreground="#FFB8C1CD" FontSize="10"
                                              Content="Auto-discover Axis LLDP neighbor when a camera is added"/>
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="#FF101318">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FF14181E" BorderBrush="#FF303640" BorderThickness="0,0,0,1" Padding="9,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ActiveBoardText" Text="Main" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="  •  drag devices here  •  drag the small dot on a node to connect" Foreground="#FF7E8997" FontSize="10" Margin="8,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ToggleButton x:Name="ConnectModeButton" Content="Connect mode" Checked="ConnectModeButton_Changed" Unchecked="ConnectModeButton_Changed" Style="{StaticResource DarkToggle}"/>
                            <Button Content="Remove links" Click="RemoveLinksButton_Click" Style="{StaticResource DarkButton}"/>
                            <Button Content="Remove selected" Click="RemoveSelectedButton_Click" Style="{StaticResource DarkButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FF101318">
                    <Grid Width="3200" Height="2000" Background="#FF101318">
                        <Canvas x:Name="LinkCanvas" Width="3200" Height="2000" IsHitTestVisible="False"/>
                        <Canvas x:Name="NodeCanvas" Width="3200" Height="2000" Background="Transparent" AllowDrop="True"
                                Drop="NodeCanvas_Drop" DragOver="NodeCanvas_DragOver"
                                MouseMove="NodeCanvas_MouseMove" MouseLeftButtonUp="NodeCanvas_MouseLeftButtonUp"/>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="2" Background="#FF171B21" BorderBrush="#FF303640" BorderThickness="1,0,0,0" Padding="15">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Selection" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock x:Name="DetailsName" Text="Select a device" Foreground="White" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DetailsType" Foreground="#FF8E98A6" FontSize="10" Margin="0,2,0,12"/>

                        <TextBlock Text="IP" Foreground="#FF798391" FontSize="9"/>
                        <TextBlock x:Name="DetailsIp" Text="-" Foreground="White" FontSize="11" Margin="0,1,0,8" TextWrapping="Wrap"/>

                        <TextBlock Text="Status" Foreground="#FF798391" FontSize="9"/>
                        <TextBlock x:Name="DetailsStatus" Text="-" Foreground="White" FontSize="11" Margin="0,1,0,8"/>

                        <TextBlock Text="Model / Description" Foreground="#FF798391" FontSize="9"/>
                        <TextBlock x:Name="DetailsModel" Text="-" Foreground="White" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,8"/>

                        <TextBlock Text="Recording Server / Source" Foreground="#FF798391" FontSize="9"/>
                        <TextBlock x:Name="DetailsRecorder" Text="-" Foreground="White" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,8"/>

                        <TextBlock Text="Port / Links" Foreground="#FF798391" FontSize="9"/>
                        <TextBlock x:Name="DetailsPort" Text="-" Foreground="White" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,10"/>

                        <Separator Background="#FF303640" Margin="0,2,0,10"/>
                        <TextBlock Text="Path on this board" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DetailsPath" Text="-" Foreground="#FFB6BEC9" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,12"/>

                        <Border x:Name="SwitchEditorPanel" Visibility="Collapsed" Background="#FF20252D" BorderBrush="#FF3B4450" BorderThickness="1" CornerRadius="5" Padding="9">
                            <StackPanel>
                                <TextBlock Text="Edit switch" Foreground="White" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBlock Text="Name" Foreground="#FF798391" FontSize="9"/>
                                <TextBox x:Name="EditSwitchNameBox" Style="{StaticResource DarkTextBox}" Margin="0,2,0,7"/>
                                <TextBlock Text="Management IP" Foreground="#FF798391" FontSize="9"/>
                                <TextBox x:Name="EditSwitchIpBox" Style="{StaticResource DarkTextBox}" Margin="0,2,0,7"/>
                                <Button Content="Save switch" Click="SaveSwitchButton_Click" Style="{StaticResource DarkButton}" Margin="0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="LldpStatusText" Foreground="#FF7FAEE8" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</external:ViewItemWpfUserControl>
